# Telegram API Credentials (dapat dari my.telegram.org)
API_ID=
API_HASH=
BOT_TOKEN=
# Fragment.com Cookies - PASTE COOKIES ANDA DI SINI
FRAGMENT_COOKIES=stel_ssid=; stel_token=; stel_ton_token=

# Fragment Hash - GANTI DENGAN HASH ANDA (dapat dari get_hash.py)
FRAGMENT_HASH=

# TON Wallet Seed Phrase (24 kata) - GANTI DENGAN WALLET ANDA
WALLET_MNEMONIC=

# TON API Key - GANTI DENGAN API KEY ANDA (dari tonconsole.com)
TON_API_KEY=

# Wallet Version (V3R1, V3R2, V4R2, atau W5)
WALLET_VERSION=V4R2

# Bot Settings
MIN_STARS=1
MAX_STARS=1000
DEFAULT_STARS=50
